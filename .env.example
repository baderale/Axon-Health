# Copy to .env and adjust as needed.

# NATS
NATS_URL=nats://nats:4222

# Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
DEFAULT_MODEL=llama3.1:8b
# Host port for the Ollama container (change if a native Ollama uses 11434)
OLLAMA_HOST_PORT=11434

# Logging
LOG_LEVEL=INFO

# Gatekeeper behavior
# Tier-1 name and place detection with spaCy (en_core_web_sm). "off" runs the
# identifier patterns only, and bare names are then not caught.
AXON_PHI_NER=spacy
