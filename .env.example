# Copy to .env and adjust as needed.

# NATS
NATS_URL=nats://nats:4222

# Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
DEFAULT_MODEL=llama3.1:8b

# Postgres (gatekeeper RAG store)
GATEKEEPER_PG_DSN=postgresql://axon:axon@postgres-gatekeeper:5432/gatekeeper

# Logging
LOG_LEVEL=INFO

# Gatekeeper behavior
HIPAA_JUDGE_MODEL=hipaa-judge.v0
COMPLIANCE_JUDGE_MODEL=compliance-judge.v0
TIER1_ESCALATE_AMBIGUOUS=true
